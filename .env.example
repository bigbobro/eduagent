# LLM(OpenAI 兼容 chat/completions 供应商;当前为 SiliconFlow DeepSeek)
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_API_KEY=<your-llm-api-key>

# 豆包语音(ASR + TTS)
DOUBAO_APP_ID=your-app-id
DOUBAO_ACCESS_KEY=your-access-key
DOUBAO_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_DEFAULT_SPEAKER=your-speaker-id

# Mock 模式(本地无网络调试)
# VOICE_MOCK=true

# SQLite 路径
DATABASE_PATH=./db/eduagent.db

# Optional Realtime classroom (independent from LLM/Doubao)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
