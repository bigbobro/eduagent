{
  "name": "eduagent",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26 <27"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "course:image-audit": "tsx scripts/prepare-course-image-jobs.ts --audit",
    "course:image-jobs": "tsx scripts/prepare-course-image-jobs.ts",
    "voice:asr-hotwords": "tsx scripts/asr-hotwords-regression.ts",
    "smoke": "tsx scripts/smoke-pages.ts",
    "smoke:lesson": "tsx scripts/lesson-smoke.ts",
    "screenshots": "tsx scripts/capture-screenshots.ts",
    "app:stage": "node desktop/scripts/stage.mjs",
    "app:pack": "pnpm app:release",
    "app:release": "node desktop/scripts/release.mjs",
    "app:verify-images": "tsx scripts/verify-app-images.ts",
    "app:e2e": "node desktop/e2e/app.e2e.mjs",
    "app:dev": "node desktop/scripts/dev.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.6.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "jsdom": "^29.1.0",
    "playwright-core": "^1.60.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "uuid": "^14.0.0",
    "vitest": "^4.1.5"
  }
}
